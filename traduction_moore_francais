oder_len):\n","\n","        predictions = model.predict(\n","            [sequence, decoder_input],\n","            verbose=0\n","        )\n","\n","        predicted_id = np.argmax(\n","            predictions[0, i-1]\n","        )\n","\n","        predicted_word = reverse_french_word_index.get(\n","            predicted_id,\n","            '<unk>'\n","        )\n","\n","        # Stop condition\n","        if predicted_word == '<end>':\n","            break\n","\n","        traduction.append(predicted_word)\n","\n","        decoder_input[0, i] = predicted_id\n","\n","    return ' '.join(traduction)"],"metadata":{"id":"D6ZsVpZrjUms","executionInfo":{"status":"ok","timestamp":1778395762130,"user_tz":-120,"elapsed":6,"user":{"displayName":"Soumana Dama","userId":"08207078104877937693"}}},"execution_count":24,"outputs":[]},{"cell_type":"markdown","source":["Premier test IMMÉDIAT"],"metadata":{"id":"WM1Y1oJNkqFW"}},{"cell_type":"code","source":["# ==========================================\n","# Test rapide\n","# ==========================================\n","\n","test_phrase = \"M paam fo\"\n","\n","traduction = traduire(test_phrase)\n","\n","print(\"Moore :\", test_phrase)\n","\n","print(\"Français :\", traduction)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"ceGXSTa2kt2s","executionInfo":{"status":"ok","timestamp":1778395762589,"user_tz":-120,"elapsed":449,"user":{"displayName":"Soumana Dama","userId":"08207078104877937693"}},"outputId":"8383e45a-1f63-4bdd-aa9f-2186bc748ba4"},"execution_count":25,"outputs":[{"output_type":"stream","name":"stdout","text":["Moore : M paam fo\n","Français : fêtes\n"]}]},{"cell_type":"code","source":["print(french_tokenizer.word_index)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"aC5raNXVm6s2","executionInfo":{"status":"ok","timestamp":1778395762653,"user_tz":-120,"elapsed":83,"user":{"displayName":"Soumana Dama","userId":"08207078104877937693"}},"outputId":"7589c3e6-21fe-4d3e-8ef2-5104f55e82d